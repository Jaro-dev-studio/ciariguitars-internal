datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// USER & AUTH
// ============================================

model User {
  id String @id @default(cuid())

  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  role      UserRole @default(ADMIN)

  projects               ProjectMember[]
  calculations           Calculation[]
  assignedTasks          Task[]           @relation("TaskAssignee")
  createdTasks           Task[]           @relation("TaskCreatedBy")
  taskViews              TaskView[]       @relation("TaskViews")
  assignedRecurringTasks RecurringTask[]  @relation("RecurringTaskAssignee")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

// ============================================
// PROJECTS
// ============================================

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)

  members                  ProjectMember[]
  tasks                    Task[]
  recurringTasks           RecurringTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

model ProjectMember {
  id String @id @default(cuid())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

// ============================================
// TASKS
// ============================================

model Task {
  id          String       @id @default(cuid())
  name        String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  attachments Attachment[]

  blockedByTasks Task[] @relation("TaskBlockedByTask")
  blockingTasks  Task[] @relation("TaskBlockedByTask")

  createdById String?
  createdBy   User?   @relation("TaskCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([createdById])
}

model Attachment {
  id   String @id @default(cuid())
  name String
  url  String
  type String
  size Int

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING_ADMIN_REVIEW
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

// ============================================
// VIEWS (saved filters for tasks)
// ============================================

model TaskView {
  id   String @id @default(cuid())
  name String

  viewMode      String  @default("table")
  sortColumn    String?
  sortDirection String  @default("asc")

  statusFilters    String[]
  priorityFilters  String[]
  projectFilters   String[]
  assigneeFilters  String[]
  createdByFilters String[]

  userId String
  user   User   @relation("TaskViews", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}


// ============================================
// RECURRING TASKS
// ============================================

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model RecurringTask {
  id          String       @id @default(cuid())
  name        String
  description String?      @db.Text
  priority    TaskPriority @default(MEDIUM)

  frequency  RecurrenceFrequency
  dayOfWeek  Int?
  dayOfMonth Int?
  isActive   Boolean             @default(true)

  lastCreatedAt DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  assigneeId String?
  assignee   User?   @relation("RecurringTaskAssignee", fields: [assigneeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([isActive])
}

// ============================================
// CALCULATIONS
// ============================================

model Calculation {
  id          String   @id @default(cuid())
  name        String
  description String?
  flowData    Json?
  createdBy   User     @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// FORM SUBMISSIONS (generic)
// ============================================

model FormSubmission {
  id String @id @default(cuid())

  name    String
  email   String
  message String?  @db.Text
  fields  Json?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// ============================================
// INTEGRATION SETTINGS
// ============================================

model IntegrationConnection {
  id String @id @default(cuid())

  platform    IntegrationPlatform
  name        String
  apiKey      String?
  apiSecret   String?
  accessToken String?
  refreshToken String?
  shopUrl     String?
  isActive    Boolean @default(true)
  lastSyncAt  DateTime?
  config      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform])
}

enum IntegrationPlatform {
  KATANA
  REVERB
  SHOPIFY
  SHIPSTATION
  MANAGEMARKETS
  SHOPFLOW
}

// ============================================
// INVENTORY & SKU MAPPING
// ============================================

model InventoryItem {
  id String @id @default(cuid())

  sku           String   @unique
  name          String
  description   String?
  category      ItemCategory @default(FINISHED_GOOD)
  
  katanaQty     Int      @default(0)
  reverbQty     Int      @default(0)
  shopifyQty    Int      @default(0)
  shopflowQty   Int      @default(0)
  
  averageCost   Float?
  landedCost    Float?
  retailPrice   Float?
  
  leadTimeDays  Int?
  isReadyToShip Boolean  @default(false)
  
  lastKatanaSyncAt  DateTime?
  lastReverbSyncAt  DateTime?
  lastShopifySyncAt DateTime?

  skuMappings   SKUMapping[]
  syncLogs      SyncLog[]
  consumptions  ProductionConsumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isReadyToShip])
}

enum ItemCategory {
  FINISHED_GOOD
  RAW_MATERIAL
  COMPONENT
  WORK_IN_PROGRESS
}

model SKUMapping {
  id String @id @default(cuid())

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  platform      IntegrationPlatform
  externalSku   String
  externalId    String?
  externalName  String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, externalSku])
  @@index([inventoryItemId])
  @@index([platform])
}

// ============================================
// SYNC LOGS & ALERTS
// ============================================

model SyncLog {
  id String @id @default(cuid())

  syncType      SyncType
  platform      IntegrationPlatform
  status        SyncStatus
  direction     SyncDirection
  
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  // What triggered the work this entry belongs to. Denormalised from the parent
  // run so the log table can be filtered by trigger without a join.
  source SyncSource @default(SYSTEM)

  // Parent execution. Null for entries written outside a tracked run.
  runId String?
  run   SyncRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  previousValue Json?
  newValue      Json?
  errorMessage  String?
  details       String? @db.Text

  // True when this entry was produced by a dry run (no real write happened).
  dryRun        Boolean @default(false)

  resolvedAt    DateTime?
  resolvedBy    String?

  createdAt DateTime @default(now())

  @@index([syncType])
  @@index([platform])
  @@index([status])
  @@index([createdAt])
  @@index([inventoryItemId])
  @@index([runId])
  @@index([source])
  @@index([status, createdAt])
}

// A single execution of a cron job, webhook delivery or manual dashboard
// action. Every SyncLog written during the execution points back here, so the
// dashboard can replay exactly what one trigger did.
model SyncRun {
  id String @id @default(cuid())

  source  SyncSource
  // Stable identifier of what ran, e.g. "sync-inventory" or "webhook:katana".
  trigger String
  status  SyncRunStatus @default(RUNNING)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  // Per-run counters and result payload; shape depends on the trigger.
  summary      Json?
  errorMessage String?

  // Request context for webhooks (topic/event) and manual runs (user id).
  triggeredBy String?

  logs SyncLog[]

  @@index([source])
  @@index([trigger])
  @@index([status])
  @@index([startedAt])
}

enum SyncSource {
  CRON
  WEBHOOK
  MANUAL
  SYSTEM
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum SyncType {
  INVENTORY_QUANTITY
  INVENTORY_COST
  PRODUCTION_CONSUMPTION
  ORDER_SYNC
  SKU_MAPPING
  LISTING_UPDATE
  // Inbound notification that Shop Flow finished building an instrument.
  // Informational only - it does not drive any sync.
  INSTRUMENT_COMPLETED
}

enum SyncStatus {
  SUCCESS
  FAILED
  PENDING
  PARTIAL
  SKIPPED
}

enum SyncDirection {
  INBOUND
  OUTBOUND
  BIDIRECTIONAL
}

model Alert {
  id String @id @default(cuid())

  type        AlertType
  severity    AlertSeverity
  title       String
  message     String @db.Text
  
  relatedSku  String?
  relatedPlatform IntegrationPlatform?
  
  isRead      Boolean @default(false)
  isDismissed Boolean @default(false)
  
  actionUrl   String?
  actionLabel String?

  // Stable fingerprint used to collapse repeated identical alerts into a single
  // row. Recurrences bump `count` and `updatedAt` instead of inserting new rows.
  dedupeKey String?
  count     Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([severity])
  @@index([isRead])
  @@index([createdAt])
  @@index([dedupeKey])
  @@index([isDismissed, createdAt])
}

enum AlertType {
  SYNC_FAILURE
  LOW_STOCK
  QUANTITY_MISMATCH
  CONNECTION_ERROR
  MANUAL_OVERRIDE
  COST_DISCREPANCY
}

enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

// ============================================
// PRODUCTION & CONSUMPTION
// ============================================

model ProductionOrder {
  id String @id @default(cuid())

  orderNumber   String   @unique
  productName   String
  productSku    String
  quantity      Int
  status        ProductionStatus @default(PLANNED)
  
  startedAt     DateTime?
  completedAt   DateTime?
  
  katanaWorkOrderId String?
  shopflowOrderId   String?

  consumptions  ProductionConsumption[]
  timers        ProductionTimer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([productSku])
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

model ProductionConsumption {
  id String @id @default(cuid())

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  quantityConsumed Int
  unitCost         Float?
  
  consumedAt       DateTime @default(now())
  syncedToKatana   Boolean @default(false)
  katanaSyncAt     DateTime?

  @@index([productionOrderId])
  @@index([inventoryItemId])
  @@index([consumedAt])
}

model ProductionTimer {
  id String @id @default(cuid())

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  stepName      String
  operatorName  String?
  
  startedAt     DateTime
  stoppedAt     DateTime?
  durationSecs  Int?
  
  laborCost     Float?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productionOrderId])
  @@index([startedAt])
}

// ============================================
// SHIPPING OPTIONS
// ============================================

model ShippingCarrier {
  id String @id @default(cuid())

  name        String
  code        String @unique
  platform    IntegrationPlatform
  isActive    Boolean @default(true)
  
  isDomestic     Boolean @default(true)
  isInternational Boolean @default(false)
  
  services    ShippingService[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingService {
  id String @id @default(cuid())

  carrierId   String
  carrier     ShippingCarrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)

  name        String
  code        String
  isActive    Boolean @default(true)
  
  estimatedDaysMin Int?
  estimatedDaysMax Int?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([carrierId, code])
  @@index([carrierId])
}

// ============================================
// SYNC CONFIGURATION
// ============================================

model SyncConfiguration {
  id String @id @default(cuid())

  syncType      SyncType
  isEnabled     Boolean @default(true)
  
  frequencyMins Int @default(15)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  
  config        Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([syncType])
}

// ============================================
// PROCESSED REVERB ORDERS (idempotency guard)
// ============================================

model ProcessedReverbOrder {
  id String @id @default(cuid())

  orderNumber   String   @unique
  source        String   @default("webhook")
  status        String?
  decrementApplied Boolean @default(false)
  katanaReference  String?

  payload       Json?
  processedAt   DateTime @default(now())

  @@index([processedAt])
}

// ============================================
// CATALOG STAGING (imported for SKU matching)
// ============================================

model KatanaCatalogVariant {
  id String @id @default(cuid())

  variantId    String  @unique
  productId    String?
  productName  String
  variantName  String?
  sku          String?
  isSellable   Boolean @default(true)
  // Katana splits finished goods ("product") from components ("material").
  // Shop Flow part numbers resolve against materials, so both are imported.
  variantType  String  @default("product")
  // sku with punctuation and case stripped, so "MTE1.0-145 Rev B" matches
  // Katana's "MTE1.0-145_RevB" without a scan at resolution time.
  normalisedSku String?

  lastImportedAt DateTime @default(now())

  @@index([sku])
  @@index([normalisedSku])
  @@index([variantType])
}

model ReverbCatalogListing {
  id String @id @default(cuid())

  listingId    String  @unique
  title        String
  make         String?
  model        String?
  finish       String?
  state        String?
  inventory    Int?
  sku          String?
  // Reverb "unique" (one-of-a-kind) listings have has_inventory = false. We
  // ignore these for sync/mapping. Null = unknown (re-import to populate).
  hasInventory Boolean?

  lastImportedAt DateTime @default(now())

  @@index([state])
}

// ============================================
// SHOP FLOW WORK ORDERS
// ============================================

// One row per Shop Flow work order (their Invoice Id, confirmed stable).
//
// Shop Flow re-sends a work order whenever it is reopened and completed again,
// so this doubles as the idempotency guard and the record of what was actually
// booked - a redelivery applies only the difference against bookedParts.
model ShopFlowWorkOrder {
  id String @id @default(cuid())

  invoiceId      String  @unique
  // "build" produces new stock; "instrument" is a repair on a customer's own
  // guitar and must never increment finished goods.
  instrumentType String
  serialNumber   String?
  instrumentName String?
  model          String?
  submodel       String?

  // Derived from the payload rather than sent by Shop Flow.
  finish         String?
  orientation    String?
  resolvedSku    String?

  status         ShopFlowWorkOrderStatus @default(RECEIVED)
  blockedReason  String?

  deliveryCount  Int      @default(1)
  /// Parts booked so far: Array<{ partId, katanaSku, variantId, quantity }>
  bookedParts    Json?
  bookedAt       DateTime?
  stockAdjustmentId String?

  /// Resolution outcome for the most recent delivery, for the events UI.
  resolutionSummary Json?
  /// Most recent payload, so a work order can be reprocessed after its part
  /// mappings are filled in without waiting for Shop Flow to resend it.
  lastPayload       Json?

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([instrumentType])
  @@index([lastSeenAt])
  @@index([serialNumber])
}

enum ShopFlowWorkOrderStatus {
  /// Captured but not yet processed.
  RECEIVED
  /// Every part resolved; ready to book.
  RESOLVED
  /// Some parts could not be mapped to Katana.
  NEEDS_MAPPING
  /// A repair, so parts consume stock but no finished good is produced.
  REPAIR
  /// Stock movement recorded in Katana.
  BOOKED
  /// Cannot proceed - see blockedReason.
  BLOCKED
}

// Overrides for Shop Flow part numbers that do not resolve against the Katana
// catalogue on their own, plus an ignore list for packaging, tooling and the
// colour option lines that ride along in the Parts array but are not stock.
model ShopFlowPartMapping {
  id String @id @default(cuid())

  shopflowPartId String  @unique
  partName       String?

  katanaSku       String?
  katanaVariantId String?

  isIgnored Boolean @default(false)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([katanaSku])
  @@index([isIgnored])
}
